# =============================================================================
# Agentic AI Tutorial - 환경변수 예시 (.env.example)
# -----------------------------------------------------------------------------
# 이 파일을 복사해서 `notebooks/.env` 를 만들고 값을 채우세요.
#   (Windows CMD)  copy .env.example .env
#
# 본 강의 기본 LLM = 로컬 Ollama + qwen3:8b
#   - 클라우드 비교가 필요하면 LLM_PROVIDER 한 줄만 google 로 바꾸면 됩니다.
#   - .env 는 절대 git 에 커밋하지 마세요(키 노출). .gitignore 에 이미 등록돼 있습니다.
# =============================================================================

# ---- 기본 공급자 선택 ----
#  ollama | llamacpp | vllm | google | nvidia | openrouter | anthropic | anthropic_oauth | openai
LLM_PROVIDER=ollama

# ---- 로컬 Ollama (기본값, OpenAI 호환 /v1) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# ---- 클라우드 비교 대상 (google 으로 전환 시 키 필요) ----
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_TOKEN=
OPENAI_API_KEY=

# ---- 무료 클라우드 API (M02_0_free_llm_api 테스트용, 선택) ----
NVIDIA_API_KEY=            # build.nvidia.com 에서 발급(무료 크레딧)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter — openrouter.ai 에서 발급(sk-or-...). OpenAI 호환.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free   # 무료 모델 자동 선택 라우터(하루 50요청, 10크레딧 이상 시 1000요청)

# ---- 기타 로컬 서버 (선택) ----
LLAMACPP_BASE_URL=http://localhost:8000/v1
LLAMACPP_MODEL=llamacpp
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- 임베딩 공급자 (M04 지식 시리즈 — agentic_lib.embeddings.get_embedder) ----
#  local | google | nvidia | openrouter | ollama | openai
#  키는 위의 LLM 용 키를 그대로 재사용한다(GOOGLE_API_KEY / NVIDIA_API_KEY / OPENROUTER_API_KEY).
EMBED_PROVIDER=local
# 공급자별 기본 모델을 바꾸고 싶을 때만 설정 (비우면 라이브러리 기본값)
# LOCAL_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2   # 384차원, 오프라인
# GOOGLE_EMBED_MODEL=gemini-embedding-001                   # EMBED_DIM 으로 차원 조절(최대 3072)
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b             # 2048차원, 다국어
# OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free   # 2048차원, 무료
# OLLAMA_EMBED_MODEL=bge-m3                                 # ollama pull bge-m3 필요
# EMBED_DIM=768             # google 전용: 출력 차원(축소 시 라이브러리가 재정규화)

# ---- Neo4j (M04_3 Graph RAG — 선택) ----
# docker run -d --name neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password -e "NEO4J_PLUGINS=[\"apoc\"]" neo4j:5-community
#   APOC 플러그인은 M04_3 의 LlamaIndex PropertyGraphIndex 에 필수(apoc.meta.data 호출)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---- Memgraph (M04_3 6장 — 선택) ----
# docker run -d --name memgraph -p 7688:7687 memgraph/memgraph:latest
#   Neo4j 와 같은 Bolt/Cypher 를 쓴다. 인증이 기본 비활성이라 사용자/비밀번호가 없다.
#   Neo4j 의 7687 과 겹치지 않게 호스트 포트만 7688 로 바꿔 매핑한다.
MEMGRAPH_URI=bolt://localhost:7688

# ---- 선택적 부가 기능 ----
# HF_TOKEN=                 # HuggingFace 모델 다운로드(게이트 모델) 시
# LANGSMITH_API_KEY=        # LangSmith 트레이싱 사용 시
# LANGSMITH_TRACING=true
